STUDYLIFE_BASE_URL=https://localhost:5001/

# Required for stdio mode (main() checks this explicitly). Optional in HTTP mode - each
# caller resolves to their own StudyLife account via OAuth instead (see
# STUDYLIFE_CONNECT_URL below), so a pure-HTTP deployment can leave this unset.
STUDYLIFE_API_KEY=change-me

# --- S4: Streamable HTTP transport + OAuth 2.1 (optional, main_http only) ---
# Leave all three unset to run stdio-only (Claude Desktop) - main() never touches these.

# Externally reachable base URL of this server behind your own reverse proxy
# (TLS terminates there). Used as both the OAuth issuer_url and resource_server_url.
# MCP_PUBLIC_URL=https://studylife-mcp.example.com

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MCP_TOKEN_ENCRYPTION_KEY=change-me

# StudyLife's own public/browser-facing base URL - the OAuth authorize() step sends the
# user's browser here to log in and consent (StudyLife's /connect/mcp page). Different
# from STUDYLIFE_BASE_URL above, which stays whatever URL this server itself calls
# server-to-server (may be a cluster-internal address the browser can't reach).
# STUDYLIFE_CONNECT_URL=https://studylife.example.com

# MCP_OAUTH_DB_PATH=oauth.db
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8000
